rules_version = '2';

// Access is granted by role, stored in users/{uid}.role ("doctor" or "secretary").
// users/* documents are created by hand in the Firebase console; the app can never write them.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isStaff() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && role() in ['doctor', 'secretary'];
    }

    function isDoctor() {
      return isStaff() && role() == 'doctor';
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /patients/{patientId} {
      allow read, create, update: if isStaff();
      allow delete: if isDoctor();

      match /photos/{visitId} {
        allow read, create, update: if isStaff();
        allow delete: if isDoctor();
      }

      // One document per visit / per operation (app schema 2).
      match /visits/{visitId} {
        allow read, create, update: if isStaff();
        allow delete: if isDoctor();
      }

      match /surgeries/{surgeryId} {
        allow read, create, update: if isStaff();
        allow delete: if isDoctor();
      }
    }

    // The app listens to all visits / operations at once (collection-group queries).
    match /{path=**}/visits/{visitId} {
      allow read: if isStaff();
    }

    match /{path=**}/surgeries/{surgeryId} {
      allow read: if isStaff();
    }

    match /settings/drugs {
      allow read: if isStaff();
      allow write: if isDoctor();
    }

    // Everything else, including the old settings/security PIN document, is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
